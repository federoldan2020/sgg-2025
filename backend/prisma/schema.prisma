//MODULO IMPRESION DE Comprobantes
// enums
enum ComprobanteTipo {
  ORDEN_PAGO
  RECIBO_AFILIADO
  REINTEGRO_AFILIADO
}

enum ComprobanteFormato {
  A4
  A5
  TICKET_80MM
}

enum ComprobanteEstado {
  EMITIDO
  ANULADO
}

// numeración correlativa por org + tipo + ptoVta + serie
model Numerador {
  id             String          @id @default(cuid())
  organizacionId String
  tipo           ComprobanteTipo
  ptoVta         Int             @default(1)
  serie          String? // opcional (p.ej. "A")
  ultimoNumero   Int             @default(0) // el último asignado
  longitud       Int             @default(8) // padding del correlativo (00000001)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizacionId, tipo, ptoVta, serie])
}

// cabecera del comprobante
model Comprobante {
  id             String          @id @default(cuid())
  organizacionId String
  tipo           ComprobanteTipo
  ptoVta         Int             @default(1)
  serie          String? // opcional
  numero         Int? // correlativo numérico (para ordenar)
  numeroCompleto String? // ej: "0001-00001234" (ptoVta-numero padded)

  titulo       String?
  fechaEmision DateTime @default(now())

  // relación a tercero (opcional si tenés módulo Terceros)
  terceroId     String?
  // snapshot denormalizado (para reimpresión/consulta histórica)
  terceroNombre String?
  terceroCuit   String?

  // importes
  subtotal     Decimal? @db.Decimal(18, 2)
  descuentos   Decimal? @db.Decimal(18, 2)
  percepciones Decimal? @db.Decimal(18, 2)
  impuestos    Decimal? @db.Decimal(18, 2)
  total        Decimal  @db.Decimal(18, 2)

  notas String?

  // impresión usada
  formato         ComprobanteFormato @default(A4)
  copias          Int                @default(2)
  templateArchivo String // ej "orden_pago.a4.njk"
  templateCss     String // ej "a4.css"
  templateVersion String? // commit/semver opcional

  // persistencia del archivo generado (ruta/clave/hashes)
  pdfStorageKey String? // ej "s3://bucket/key.pdf" o disco "file://..."
  pdfHash       String? // sha256 para deduplicar/verificar

  // payload de origen (snapshot del DTO de impresión)
  payload Json // ImprimirComprobanteDto "congelado"

  estado        ComprobanteEstado @default(EMITIDO)
  anuladoMotivo String?
  anuladoAt     DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          ComprobanteItem[]
  reintegroPagos ReintegroPago[]

  @@unique([organizacionId, tipo, ptoVta, serie, numero])
  @@index([organizacionId, fechaEmision])
  @@index([tipo, fechaEmision])
}

// detalle del comprobante
model ComprobanteItem {
  id            String   @id @default(cuid())
  comprobanteId String
  orden         Int // posición de línea
  desc          String
  cantidad      Decimal  @db.Decimal(12, 2)
  pUnit         Decimal? @db.Decimal(12, 2)
  importe       Decimal  @db.Decimal(18, 2)

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId, orden])
}

//SPRINT MOVIMIENTOS afiliados
enum Moneda {
  ARS
  USD
}

/// ===================== Submayor Afiliados (Cuenta Corriente) =====================
enum NaturalezaMovimientoAf {
  debito // aumenta deuda del afiliado
  credito // disminuye deuda del afiliado
}

enum OrigenMovimientoAf {
  orden_credito // débito total al generar OC (o por materializar)
  cuota // débito por generación/imputación de cuota
  pago_caja // crédito por cobro en caja
  nomina // crédito por descuento por nómina
  ajuste // débito/crédito manual
  anulacion // movimiento inverso para revertir
}

model MovimientoAfiliado {
  id             BigInt   @id @default(autoincrement())
  organizacionId String
  afiliadoId     BigInt
  padronId       BigInt?
  fecha          DateTime @default(now()) // Fecha física del movimiento (para orden cronológico y saldo)

  naturaleza NaturalezaMovimientoAf // debito | credito
  origen     OrigenMovimientoAf // trazabilidad funcional
  concepto   String

  // importe SIEMPRE positivo; signo lo determina `naturaleza`
  importe Decimal @db.Decimal(14, 2)

  // --- NUEVO ---
  moneda        Moneda? // moneda original del hecho económico, si aplica
  importeMoneda Decimal? @db.Decimal(14, 2) // importe en moneda original
  tcAplicado    Decimal? @db.Decimal(12, 6) // TC usado

  // trazabilidad de negocio
  obligacionId   BigInt?
  ordenId        BigInt?
  cuotaId        BigInt?
  pagoId         BigInt?
  referenciaId   BigInt? // por si querés link genérico alternativo
  referenciaTipo String? // 'ORDEN' | 'CUOTA' | 'PAGO' | 'OBLIGACION' | ...

  // contabilidad (doble partida) — opcional
  asientoId BigInt?

  // performa
  saldoPosterior Decimal? @db.Decimal(14, 2)

  // Período contable: para agrupar movimientos por período cuando corresponde
  // Formato: "YYYY-MM" (ej: "2026-02")
  // Se usa cuando el movimiento corresponde a un período específico (ej: cuota de febrero)
  // Permite agrupar por período sin afectar el orden cronológico ni el cálculo de saldo
  periodoContable String? // Período al que corresponde el movimiento (para agrupación/reportes)

  // relaciones
  organizacion Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  afiliado     Afiliado           @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)
  padron       Padron?            @relation(fields: [padronId], references: [id])
  asiento      Asiento?           @relation(fields: [asientoId], references: [id])
  obligacion   Obligacion?        @relation(fields: [obligacionId], references: [id])
  orden        OrdenCredito?      @relation(fields: [ordenId], references: [id])
  cuota        OrdenCreditoCuota? @relation(fields: [cuotaId], references: [id])

  @@index([organizacionId, afiliadoId, fecha, id])
  @@index([organizacionId, afiliadoId])
  @@index([organizacionId, origen])
  @@index([organizacionId, obligacionId])
  @@index([organizacionId, ordenId])
  @@index([organizacionId, cuotaId])
  @@index([organizacionId, pagoId])
  @@index([organizacionId, afiliadoId, periodoContable]) // Para agrupar por período
}

/**
 * ===================== Circuito Suspensiones (Fase 1) =====================
 * Documentación funcional completa en:
 * docs/CIRCUITO_AFILIADOS_DEUDA_SUSPENSION.md
 * Núcleo del modelo de morosidad por cobertura mínima de J17 (con J22/J38/K16
 * cuando corresponde). Habilita: parámetros con vigencia, cálculo de
 * cobertura por afiliado y período, suspensión / rehabilitación automática,
 * excepciones ADMIN y cierre mensual con dry-run.
 */

/// Historia del valor mínimo de J17 (parametrizable). Único por organización.
model ParametroJ17Minimo {
  id             BigInt    @id @default(autoincrement())
  organizacionId String
  valor          Decimal   @db.Decimal(12, 2)
  vigenteDesde   DateTime  @db.Date
  vigenteHasta   DateTime? @db.Date
  creadoPorId    String?
  creadoEn       DateTime  @default(now())

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, vigenteDesde])
}

/// Historia del valor de cuota J17 para afiliados tipo 04. Único por organización.
model ParametroJ17Cuota04 {
  id             BigInt    @id @default(autoincrement())
  organizacionId String
  valor          Decimal   @db.Decimal(12, 2)
  vigenteDesde   DateTime  @db.Date
  vigenteHasta   DateTime? @db.Date
  creadoPorId    String?
  creadoEn       DateTime  @default(now())

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, vigenteDesde])
}

/// Estados posibles del afiliado (formaliza el campo string `Afiliado.estado`).
/// Valores permitidos: activo | suspendido_provisorio | suspendido_firme | baja | baja_incobrable
/// La validación se hace en la capa de servicio para no romper datos legacy.

/// Historial de suspensiones del afiliado. Una suspensión vive desde
/// `fechaInicio` hasta `fechaFin`. El estado actual del afiliado se calcula
/// como "tiene una suspensión sin cerrar".
model AfiliadoSuspension {
  id              BigInt    @id @default(autoincrement())
  organizacionId  String
  afiliadoId      BigInt
  /// Período (YYYY-MM) que originó la mora
  periodoOrigen   String
  /// provisoria | firme | revertida | rehabilitada
  estado          String    @default("provisoria")
  fechaInicio     DateTime  @default(now())
  /// Cuándo pasó a `firme` (día 16). Null mientras es provisoria.
  fechaFirme      DateTime?
  /// Cuándo se cerró (rehabilitación o reversión). Null si está activa.
  fechaFin        DateTime?
  /// pago_caja | cobranza_periodo | excepcion_admin | reversion_admin
  motivoFin       String?
  /// usuario que ejecutó (null si fue automático)
  creadoPorId     String?
  finalizadoPorId String?
  observacion     String?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  afiliado     Afiliado     @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@index([organizacionId, afiliadoId])
  @@index([organizacionId, estado])
  @@index([organizacionId, periodoOrigen])
  @@index([organizacionId, afiliadoId, estado])
}

/// Excepción ADMIN: afiliados que NO se suspenden automáticamente.
/// Sólo ADMIN/SUPERADMIN puede crear/desactivar.
model AfiliadoExcepcionSuspension {
  id               BigInt    @id @default(autoincrement())
  organizacionId   String
  afiliadoId       BigInt
  motivo           String
  /// Null = indefinida
  vigenciaHasta    DateTime? @db.Date
  activa           Boolean   @default(true)
  creadoPorId      String
  creadoEn         DateTime  @default(now())
  desactivadoEn    DateTime?
  desactivadoPorId String?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  afiliado     Afiliado     @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@index([organizacionId, afiliadoId, activa])
  @@index([organizacionId, activa])
}

/// Resumen materializado de cobertura por afiliado y período.
/// Se recalcula al procesar TXT de retorno o al cobrar por caja.
model CoberturaAfiliadoPeriodo {
  id             BigInt @id @default(autoincrement())
  organizacionId String
  afiliadoId     BigInt
  periodo        String // "YYYY-MM"

  j17Esperado Decimal @db.Decimal(12, 2)
  j17Cobrado  Decimal @default(0) @db.Decimal(12, 2)
  j22Esperado Decimal @default(0) @db.Decimal(12, 2)
  j22Cobrado  Decimal @default(0) @db.Decimal(12, 2)
  j38Esperado Decimal @default(0) @db.Decimal(12, 2)
  j38Cobrado  Decimal @default(0) @db.Decimal(12, 2)
  k16Esperado Decimal @default(0) @db.Decimal(12, 2)
  k16Cobrado  Decimal @default(0) @db.Decimal(12, 2)

  /// True si todos los códigos aplicables están cubiertos (derivado de los 3 flags).
  cubierto    Boolean
  /// Cubierto por concepto (modelo de gates separados — bloque 2 de decisiones).
  /// j17 → estado afiliado | j22 → coseguro | j38 → colaterales.
  j17Cubierto Boolean  @default(false)
  /// true cuando NO aplica (afiliado sin coseguro) o cuando se cobró completo.
  j22Cubierto Boolean  @default(true)
  /// true cuando NO aplica (sin colaterales activos) o cuando se cobró completo.
  j38Cubierto Boolean  @default(true)
  /// Suma de diferencias (esperado − cobrado) ≥ 0.
  deudaTotal  Decimal  @db.Decimal(12, 2)
  calculadoEn DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  afiliado     Afiliado     @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, afiliadoId, periodo], name: "cobertura_unique_org_afiliado_periodo")
  @@index([organizacionId, periodo, cubierto])
  @@index([organizacionId, afiliadoId])
}

/// Corrida de cierre mensual. Persiste el informe ejecutado el día 10.
model CierreMensual {
  id             BigInt    @id @default(autoincrement())
  organizacionId String
  periodo        String // "YYYY-MM" evaluado (el período que se cierra)
  /// en_curso | completado | fallido | dry_run
  estado         String    @default("en_curso")
  iniciadoEn     DateTime  @default(now())
  finalizadoEn   DateTime?
  /// Null si fue automático por el cron.
  iniciadoPorId  String?

  totalSuspendidos      Int @default(0)
  totalRehabilitados    Int @default(0)
  totalPadronesMarcados Int @default(0)
  totalExcluidos        Int @default(0)

  /// Detalle estructurado del informe (afiliados afectados, motivos, etc.)
  resumen      Json?
  errorMensaje String?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, periodo])
  @@index([organizacionId, estado])
}

/**
 * ===================== Generación de Novedades (Fase 1) =====================
 * Documentación funcional en: docs/CIRCUITO_AFILIADOS_DEUDA_SUSPENSION.md § 9
 * Bloque 3 (decisiones 24-40).
 * Flujo:
 * - El día 10 del mes M, UDAP corre `generarBorrador(periodo=M, canal='ESC')`.
 * - El sistema arma el archivo TXT con deltas vs el último envío + K16 vigentes.
 * - El operador descarga el .txt, lo envía por mail a Cómputos y marca el lote
 * como `enviado` (botón con confirm). En ese momento se bloquean las
 * Obligaciones referenciadas (`bloqueada=true`).
 * - Al procesar el TXT de retorno (módulo nomina/importar-cobranza), las
 * obligaciones se concilian y se desbloquean.
 */

model NovedadLote {
  id             BigInt @id @default(autoincrement())
  organizacionId String
  /// "YYYY-MM"
  periodo        String
  /// "ESC" (futuros: "ANSES", "PP")
  canal          String @default("ESC")
  /// borrador | enviado | parcialmente_conciliado | conciliado | anulado
  estado         String @default("borrador")

  generadoEn      DateTime  @default(now())
  generadoPorId   String?
  enviadoEn       DateTime?
  enviadoPorId    String?
  conciliadoEn    DateTime?
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  /// Nombre sugerido para el archivo descargado
  archivoNombre    String?
  /// SHA256 del contenido
  archivoHash      String?
  /// Snapshot inmutable del .txt
  archivoContenido String? @db.Text

  totalLineas    Int     @default(0)
  totalAfiliados Int     @default(0)
  totalJ22       Decimal @default(0) @db.Decimal(14, 2)
  totalJ38       Decimal @default(0) @db.Decimal(14, 2)
  totalK16       Decimal @default(0) @db.Decimal(14, 2)
  /// Cantidad de líneas con J17 alta y baja respectivamente
  totalJ17Altas  Int     @default(0)
  totalJ17Bajas  Int     @default(0)

  items                  NovedadLoteItem[]
  obligacionesBloqueadas NovedadLoteObligacion[]
  bajasInformadas        BajaInformable[]
  novedadesPendientes    NovedadPendiente[]

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, periodo, canal, estado])
}

model NovedadLoteItem {
  id             BigInt @id @default(autoincrement())
  loteId         BigInt
  padronId       BigInt
  afiliadoId     BigInt
  /// Snapshot del centro y padrón al momento de la generación
  centroSnapshot Int?
  padronSnapshot String

  /// Línea del .txt exactamente como se envió (80 chars). Inmutable.
  lineaCompleta  String
  /// "alta" | "baja" | "mixto" | "k16_solo"
  tipoMovimiento String
  /// Indicador final de la línea (ej. "B3")
  indicador      String @default("B3")

  /// Null = el bloque no aparece. 0 = bloque baja. >0 = bloque alta con monto.
  valorJ17 Decimal? @db.Decimal(12, 2)
  valorJ22 Decimal? @db.Decimal(12, 2)
  valorJ38 Decimal? @db.Decimal(12, 2)
  valorK16 Decimal? @db.Decimal(12, 2)

  lote       NovedadLote         @relation(fields: [loteId], references: [id], onDelete: Cascade)
  padron     Padron              @relation(fields: [padronId], references: [id])
  afiliado   Afiliado            @relation(fields: [afiliadoId], references: [id])
  k16Detalle NovedadK16Detalle[]

  @@index([loteId, padronId])
  @@index([padronId])
}

model NovedadK16Detalle {
  id            BigInt  @id @default(autoincrement())
  loteItemId    BigInt
  obligacionId  BigInt
  /// "cuota_mes" | "saldo_arrastrado" | "interes"
  componente    String
  monto         Decimal @db.Decimal(12, 2)
  /// Período del que proviene el componente (YYYY-MM)
  periodoOrigen String

  loteItem   NovedadLoteItem @relation(fields: [loteItemId], references: [id], onDelete: Cascade)
  obligacion Obligacion      @relation(fields: [obligacionId], references: [id])

  @@index([loteItemId])
}

model NovedadLoteObligacion {
  id             BigInt    @id @default(autoincrement())
  loteId         BigInt
  obligacionId   BigInt
  desbloqueadaEn DateTime?

  lote       NovedadLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  obligacion Obligacion  @relation(fields: [obligacionId], references: [id])

  @@unique([loteId, obligacionId])
  @@index([obligacionId])
}

/// Registro de cada baja a informar a Cómputos. Lo crean: operadores (manual),
/// el cierre mensual (cierre_inactivo_3m) y los jobs de baja automática
/// (baja_auto_coseguro_3m_sin_j22, etc.).
model BajaInformable {
  id              BigInt   @id @default(autoincrement())
  organizacionId  String
  padronId        BigInt
  /// "PADRON_COMPLETO" | "J17" | "J22" | "J38" | "K16"
  codigo          String
  /// "manual_operador" | "cierre_inactivo_3m" | "baja_auto_coseguro_3m_sin_j22" | "baja_auto_colaterales_3m_sin_j38" | "baja_incobrable_admin" | "fallecimiento" | "renuncia"
  motivo          String
  observacion     String?
  fechaSolicitada DateTime @default(now())
  /// Null si fue automática
  solicitadoPorId String?

  /// pendiente | informada | cancelada
  estado            String    @default("pendiente")
  loteEnvioId       BigInt?
  fechaInformada    DateTime?
  fechaCancelada    DateTime?
  canceladaPorId    String?
  motivoCancelacion String?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  padron       Padron       @relation(fields: [padronId], references: [id], onDelete: Cascade)
  lote         NovedadLote? @relation(fields: [loteEnvioId], references: [id])

  @@index([organizacionId, estado])
  @@index([padronId, codigo, estado])
}

/// ===================== Novedades pendientes (operator-driven) =====================
/// Cola de novedades J17/J22/J38 que el operador (o un hook automático) va
/// acumulando durante el mes y que se vuelcan al lote correspondiente al
/// confirmar el cierre. Reemplaza el modelo "snapshot del estado vigente".
///
/// Reglas:
///   - alta / modificacion: requieren `valor`.
///   - baja: `valor` queda null.
///   - destino COMPUTOS: concepto puede ser J17 | J22 | J38.
///   - destino ANSES:    concepto sólo puede ser J17.
///   - Una pendiente sólo puede asociarse a UN lote (loteId se setea al enviar).
model NovedadPendiente {
  id             BigInt @id @default(autoincrement())
  organizacionId String
  padronId       BigInt
  afiliadoId     BigInt

  /// "J17" | "J22" | "J38"
  concepto       String
  /// "alta" | "baja" | "modificacion"
  tipoMovimiento String
  /// "COMPUTOS" | "ANSES"
  destino        String
  /// Para alta/modificacion: valor a informar. Null para baja.
  valor          Decimal? @db.Decimal(12, 2)
  /// Período del lote donde debe salir (YYYY-MM)
  periodoObjetivo String

  /// "pendiente" | "enviada" | "cancelada"
  estado String @default("pendiente")

  /// Origen del evento (audit trail).
  /// "hook_coseguro_alta" | "hook_coseguro_baja" |
  /// "hook_colaterales_alta" | "hook_colaterales_baja" |
  /// "hook_afiliado_alta" | "hook_afiliado_baja" |
  /// "manual_operador"
  origenEvento String
  observacion  String?

  creadoEn    DateTime @default(now())
  creadoPorId String?

  /// Al confirmar el lote
  loteId    BigInt?
  enviadaEn DateTime?

  /// Cuando el operador cancela antes del envío
  canceladaEn       DateTime?
  canceladaPorId    String?
  motivoCancelacion String?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  padron       Padron       @relation(fields: [padronId], references: [id], onDelete: Cascade)
  afiliado     Afiliado     @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)
  lote         NovedadLote? @relation(fields: [loteId], references: [id])

  @@index([organizacionId, estado, periodoObjetivo, destino])
  @@index([padronId, concepto, estado])
  @@index([loteId])
}
