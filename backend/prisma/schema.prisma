/// ===================== Orden de Pago (por rol) =====================
enum EstadoOrdenPago {
  borrador
  confirmado
  anulado
}

enum MetodoPagoOP {
  transferencia
  cheque
  efectivo
  otro
}

model OrdenPagoTercero {
  id             BigInt          @id @default(autoincrement())
  numeroOP       Int? // ← nuevo
  organizacionId String
  terceroId      BigInt
  cuentaId       BigInt
