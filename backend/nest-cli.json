{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assetsInclude": ["**/*.json", "**/*.html", "**/*.txt"]
  },
  "watchMode": {
    "watch": ["src"],
    "ext": "ts,json,js,html,txt",
    "ignore": ["dist", "node_modules", "*.spec.ts", "coverage"]
  }
}
