# Base de datos
POSTGRES_USER=sgg_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=sgg_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sgg_user:your_strong_password_here@postgres:5432/sgg_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRATION=1d

# Puertos
BACKEND_PORT=3000
FRONTEND_PORT=3010

# URLs
NEXT_PUBLIC_API_URL=https://api.tudominio.com
FRONTEND_URL=https://tudominio.com

# Producción
NODE_ENV=production
